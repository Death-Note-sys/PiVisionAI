{
    "id": "core-edge-detection",
    "name": "Edge Detection",
    "version": "1.0.0",
    "author": "Pi Vision AI Core",
    "description": "Applies various edge detection filters like Canny, Sobel, and Laplacian.",
    "dependencies": ["opencv-python"],
    "supported_tasks": ["Image Processing"],
    "required_models": [],
    "entry_point": "edge_module.py:EdgeDetectionModule",
    "settings": {
        "algorithm": {
            "type": "select",
            "options": ["Canny", "Sobel", "Laplacian", "Scharr"],
            "default": "Canny"
        },
        "threshold1": {
            "type": "slider",
            "min": 0,
            "max": 500,
            "step": 1,
            "default": 100
        },
        "threshold2": {
            "type": "slider",
            "min": 0,
            "max": 500,
            "step": 1,
            "default": 200
        },
        "kernel_size": {
            "type": "slider",
            "min": 1,
            "max": 3,
            "step": 1,
            "default": 1
        }
    }
}
