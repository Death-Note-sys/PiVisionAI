{
    "id": "core-object-counting",
    "name": "Object Counting",
    "version": "1.0.0",
    "author": "Pi Vision AI Core",
    "description": "Fast template-matching similar object counting with taught reference and count judging.",
    "category": "Vision",
    "task": "Object Counting",
    "entry_point": "plugin.py:ObjectCountingPlugin",
    "renderer": "object_counting",
    "api_version": "v1",
    "supported_camera_types": ["rgb"],
    "supported_results": ["ObjectCountingResult"],
    "required_models": [],
    "required_backends": [],
    "optional_backends": [],
    "permissions": ["camera"],
    "dependencies": ["opencv-python", "numpy"],
    "minimum_framework_version": "1.0.0",
    "license": "MIT",
    "settings_schema": {
        "match_threshold": {"type": "float", "default": 0.7},
        "suppress_frac": {"type": "float", "default": 0.5},
        "iou_threshold": {"type": "float", "default": 0.3},
        "allow_size_variation": {"type": "boolean", "default": false},
        "size_variation_pct": {"type": "integer", "default": 10},
        "max_objects": {"type": "integer", "default": 200},
        "work_scale": {"type": "float", "default": 1.0},
        "show_boxes": {"type": "boolean", "default": true},
        "show_numbers": {"type": "boolean", "default": true},
        "thickness": {"type": "integer", "default": 2},
        "judge_enabled": {"type": "boolean", "default": false},
        "count_min": {"type": "integer", "default": 0},
        "count_max": {"type": "integer", "default": 0}
    }
}
